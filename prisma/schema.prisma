generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producto {
  id           Int      @id @default(autoincrement())
  nombre       String
  categoria    String
  precio_costo Float
  imagen_url   String
  disponible   Boolean  @default(true)
  // Oculto a mano (ej: sin foto usable). La sincronización con Viena no lo vuelve a mostrar.
  oculto_manual Boolean @default(false)
  url_origen   String   @unique
  descripcion  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Configuracion {
  id                Int    @id @default(autoincrement())
  margen_ganancia   Float  @default(1.35)
  margen_financiado Float  @default(1.75)
  cuotas            Int    @default(12)
  interes_cuota     Float  @default(0.038)
  whatsapp_numero   String @default("5491100000000")
  whatsapp_numero_2 String @default("")
}

model LogSincronizacion {
  id                    Int      @id @default(autoincrement())
  fecha                 DateTime @default(now())
  productos_nuevos      Int
  productos_actualizados Int
  errores               String?
}

// Vendedores externos: cada uno tiene su link (?v=codigo) y los clientes
// que entran por ese link le escriben a su WhatsApp.
model Vendedor {
  id        Int      @id @default(autoincrement())
  nombre    String
  localidad String   @default("")
  whatsapp  String
  codigo    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Fotos subidas desde el admin. Se guardan en la base (en Vercel no se
// pueden guardar archivos). imagen_url del producto queda "/subidas/<id>-<marca>".
model FotoSubida {
  productoId  Int      @id
  datos       Bytes
  actualizado DateTime @updatedAt
}
