{
  "compilerOptions": {
    "lib": ["es2021", "dom"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "outDir": "./dist",
    "target": "es2021"
  },
  "include": ["scripts/**/*.ts", "prisma/seed.ts"],
  "exclude": ["node_modules"]
}
